# Package Control builds the package with `git archive`: these stay out of it.
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/tests export-ignore
/images export-ignore
/ruff.toml export-ignore
/CHANGELOG.md export-ignore

# The settings, commands and menus are JSON with comments; one line ending everywhere.
*.sublime-* text eol=lf
*.py text eol=lf
